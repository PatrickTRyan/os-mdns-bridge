<model>
    <mount>//OPNsense/MDNSBridge</mount>
    <version>0.1.0</version>
    <description>mDNS Bridge settings</description>

    <items>

        <enabled type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </enabled>

        <enablecarp type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </enablecarp>

        <interfaces type="InterfaceField">
            <Default>lan</Default>
            <Required>Y</Required>
            <Multiple>Y</Multiple>
        </interfaces>

        <disableipv4 type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </disableipv4>

        <disableipv6 type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </disableipv6>

        <allowinboundfilters type="TextField">
            <Required>N</Required>
            <FieldSeparator>,</FieldSeparator>
        </allowinboundfilters>

    </items>

</model>
