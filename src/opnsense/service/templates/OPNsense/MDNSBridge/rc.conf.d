{#
  rc.conf.d for the FreeBSD port's rc script (net/mdns-bridge).
  Enable rule matches MDNSBridge::isServiceEnabled(): the switch on and at
  least two enabled interface entries. The control script reports a clear
  error if those entries no longer resolve to usable interfaces.
#}
{% set enabled_entries = [] %}
{% if helpers.exists('OPNsense.MDNSBridge.ifaces.iface') %}
{%   for entry in helpers.toList('OPNsense.MDNSBridge.ifaces.iface') %}
{%     if (entry.enabled or '0') == '1' and entry.interface and entry.interface not in enabled_entries %}
{%       do enabled_entries.append(entry.interface) %}
{%     endif %}
{%   endfor %}
{% endif %}
#
# Generated by os-mdns-bridge. Do not edit.
#
{% if helpers.exists('OPNsense.MDNSBridge.general.enabled') and OPNsense.MDNSBridge.general.enabled == '1' and enabled_entries | length >= 2 %}
mdns_bridge_enable="YES"
mdns_bridge_config="/usr/local/etc/mdns-bridge.conf"
{%   if OPNsense.MDNSBridge.general.log_warnings == '1' %}
mdns_bridge_flags="-w"
{%   endif %}
{%   if OPNsense.MDNSBridge.general.carp_depend_on %}
# CARP dependency set: rc.subr refuses "start" until mdnsbridge_ctl.php
# confirms this node is MASTER and creates the marker below.
required_files="/var/run/mdns_bridge.carp_master"
{%   endif %}
{% else %}
mdns_bridge_enable="NO"
{% endif %}
