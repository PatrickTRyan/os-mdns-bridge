<model>
    <mount>//OPNsense/MDNSBridge</mount>
    <version>1.0.0</version>
    <description>mDNS Bridge settings</description>
    <!--
        Structure mirrors mdns-bridge.conf:
          general  -> [global] section and daemon flags
          ifaces   -> the "interfaces =" list plus one [device] section each
          peers    -> peer-allow/deny-outbound-filters lines in [device] sections
        Cross-field rules the daemon enforces at startup are checked in
        MDNSBridge.php so that a saved configuration always starts.
    -->
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <carp_depend_on type="VirtualIPField">
                <type>carp</type>
                <key>mvc</key>
            </carp_depend_on>
            <log_warnings type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </log_warnings>
            <disable_ipv4 type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </disable_ipv4>
            <disable_ipv6 type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </disable_ipv6>
            <inbound_mode type="OptionField">
                <Default>none</Default>
                <Required>Y</Required>
                <OptionValues>
                    <none>No global filter (forward all services)</none>
                    <allow>Allow only the listed services</allow>
                    <deny>Deny the listed services</deny>
                </OptionValues>
            </inbound_mode>
            <inbound_presets type=".\ServicePresetField">
                <Multiple>Y</Multiple>
            </inbound_presets>
            <inbound_filters type=".\FilterListField"/>
        </general>
        <ifaces>
            <iface type="ArrayField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <interface type="InterfaceField">
                    <Required>Y</Required>
                    <Filters>
                        <if>/^(?!lo0$).*/</if>
                    </Filters>
                    <Constraints>
                        <check001>
                            <type>UniqueConstraint</type>
                            <ValidationMessage>This interface is already part of the bridge.</ValidationMessage>
                        </check001>
                    </Constraints>
                </interface>
                <disable_ipv4 type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </disable_ipv4>
                <disable_ipv6 type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </disable_ipv6>
                <inbound_mode type="OptionField">
                    <Default>none</Default>
                    <Required>Y</Required>
                    <OptionValues>
                        <none>No inbound filter</none>
                        <allow>Allow only the listed services</allow>
                        <deny>Deny the listed services</deny>
                    </OptionValues>
                </inbound_mode>
                <inbound_presets type=".\ServicePresetField">
                    <Multiple>Y</Multiple>
                </inbound_presets>
                <inbound_filters type=".\FilterListField"/>
                <outbound_mode type="OptionField">
                    <Default>none</Default>
                    <Required>Y</Required>
                    <OptionValues>
                        <none>No outbound filter</none>
                        <allow>Allow only the listed services</allow>
                        <deny>Deny the listed services</deny>
                    </OptionValues>
                </outbound_mode>
                <outbound_presets type=".\ServicePresetField">
                    <Multiple>Y</Multiple>
                </outbound_presets>
                <outbound_filters type=".\FilterListField"/>
                <description type="DescriptionField"/>
            </iface>
        </ifaces>
        <peers>
            <peer type="ArrayField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <interface type="InterfaceField">
                    <Required>Y</Required>
                    <Filters>
                        <if>/^(?!lo0$).*/</if>
                    </Filters>
                </interface>
                <source type="InterfaceField">
                    <Required>Y</Required>
                    <Filters>
                        <if>/^(?!lo0$).*/</if>
                    </Filters>
                </source>
                <mode type="OptionField">
                    <Default>allow</Default>
                    <Required>Y</Required>
                    <OptionValues>
                        <allow>Allow only the listed services</allow>
                        <deny>Deny the listed services</deny>
                    </OptionValues>
                </mode>
                <presets type=".\ServicePresetField">
                    <Multiple>Y</Multiple>
                </presets>
                <filters type=".\FilterListField"/>
                <description type="DescriptionField"/>
            </peer>
        </peers>
    </items>
</model>
