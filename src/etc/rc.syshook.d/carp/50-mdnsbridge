#
# CARP event hook: $1 is "vhid@device", $2 is the new state.
# The control script re-reads the actual state of the configured CARP
# dependency, so the event itself is only a trigger. It does nothing when
# mDNS Bridge is disabled or has no CARP dependency.

case "${2}" in
MASTER|BACKUP|INIT)
	;;
*)
	exit 0
	;;
esac

exec /usr/local/opnsense/scripts/OPNsense/MDNSBridge/mdnsbridge_ctl.php carp > /dev/null 2>&1
