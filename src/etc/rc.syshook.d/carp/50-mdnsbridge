require_once('config.inc');

/** @var \OPNsense\MDNSBridge\MDNSBridge $model */
$model = new \OPNsense\MDNSBridge\MDNSBridge();

if (
    (string)$model->enabled !== '1' ||
    (string)$model->enablecarp !== '1'
) {
    exit(0);
}

$subsystem = isset($argv[1]) ? trim((string)$argv[1]) : '';
$type = isset($argv[2]) ? strtoupper(trim((string)$argv[2])) : '';

if (
    preg_match('/^[0-9]+@[A-Za-z0-9_.:-]+$/D', $subsystem) !== 1 ||
    !in_array($type, ['MASTER', 'BACKUP'], true)
) {
    openlog('mdnsbridge-carp', LOG_PID, LOG_DAEMON);
    syslog(
        LOG_NOTICE,
        sprintf(
            'Ignoring invalid CARP event: subsystem="%s", type="%s"',
            $subsystem,
            $type
        )
    );
    closelog();

    exit(1);
}

$backend = new \OPNsense\Core\Backend();

/*
 * Recalculate the state of all selected CARP interfaces. Do not make a
 * global service decision from one individual VIP transition.
 */
$backend->configdRun('mdnsbridge carp-reconcile-service');

exit(0);
