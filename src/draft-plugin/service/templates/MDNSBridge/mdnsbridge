{% if helpers.exists('OPNsense.MDNSBridge.enabled') and OPNsense.MDNSBridge.enabled == '1' %}

{% from 'OPNsense/Macros/interface.macro' import physical_interface %}

{% set osifnames = OPNsense.MDNSBridge.interfaces.split(',') %}
{% set interface_list = [] %}

{% for iface in osifnames %}
{% do interface_list.append(physical_interface(iface)) %}
{% endfor %}

[global]

interfaces = {{ interface_list | join(', ') }}

{% if helpers.exists('OPNsense.MDNSBridge.disableipv4') and OPNsense.MDNSBridge.disableipv4 == '1' %}
disable-ipv4 = yes
{% else %}
disable-ipv4 = no
{% endif %}

{% if helpers.exists('OPNsense.MDNSBridge.disableipv6') and OPNsense.MDNSBridge.disableipv6 == '1' %}
disable-ipv6 = yes
{% else %}
disable-ipv6 = no
{% endif %}

{% if helpers.exists('OPNsense.MDNSBridge.allowinboundfilters')
      and OPNsense.MDNSBridge.allowinboundfilters != '' %}
allow-inbound-filters = {{
    OPNsense.MDNSBridge.allowinboundfilters
        .split(',')
        | join(', ')
}}
{% endif %}

{% endif %}
