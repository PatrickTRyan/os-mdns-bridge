# Everything that ends up on the firewall must have LF line endings:
# a CRLF after "#!/usr/local/bin/php" or "#!/bin/sh" makes the script
# fail to execute, and CRLF in templates leaks into generated config.
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary
*.gif binary
*.bmp binary
*.tiff binary
*.pkg binary
